#!/usr/bin/bash
#!/usr/bin/env bash

cd "$(dirname "$(realpath "$0")")"

cont="track"
image="track"

usage () {
    cat <<EOF
$0 [command]
commands:
    ps     list containers
    build  build '$image' image
    sh     interactive shell
    run    run '$cont' container
    rm     remove container
    start  start container
    stop   stop container
    logs   container logs
EOF
}

case "$1" in
    (ps) docker ps -a ;;
    (build) docker build -t "$image" . ;;
    (sh) docker exec -it "$cont" sh ;;
    (run)
        docker run \
            -d \
            --env-file .env \
            -p 127.0.0.1:4321:4321 \
            -v track-data:/data \
            --name "$cont" \
            "$image"
    ;;
    (rm) docker rm "$cont" ;;
    (start) docker start "$cont" ;;
    (stop) docker stop "$cont" ;;
    (logs) docker logs -f "$cont" ;;
    (*) usage ;;
esac

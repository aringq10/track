div(id="summary")
  if projects.length !== 0
    each p in projects
      div(class="project")
        div(class="project-header")
          div(class="project-name") #{p.projectName}
        div(class="project-summary")
          table(class="project-table")
            thead
              tr
                th tot dur
                th act / tot
                th dur / tot
                th dur / act
            tbody
              tr
                td #{p.totalDuration}
                td #{p.activeDays}/#{p.totalDays} #{p.pctgActTot}%
                td #{p.durPerDay}
                td #{p.durPerAct}
          hr
          div(class="project-daily")
            each d in p.days
              if d
                div(class="active")
              else
                div(class="inactive")

  else
    div(id="summary-empty") No summaries
